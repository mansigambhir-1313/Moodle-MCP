# Supabase DB key — server-side only, NEVER exposed to the MCP host.
# PREFER a least-privilege, SELECT-only JWT (role=reporting_readonly) over the full
# service_role key. Apply sql/2026-08-26_reporting_readonly_role.sql, then mint a JWT
# with {"role":"reporting_readonly"} signed with the project JWT secret and put it here.
# The server logs a warning at boot if it detects a full service_role key.
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_DATA_KEY=<reporting_readonly-jwt>
SUPABASE_OAUTH_STORAGE_KEY=<mcp_oauth_writer-jwt>
SUPABASE_AUDIT_KEY=<mcp_audit_writer-jwt>
# Legacy fallback during migration only; remove after SUPABASE_DATA_KEY is live.
SUPABASE_SERVICE_ROLE_KEY=
# Anon/publishable key (public — safe to expose). REQUIRED when the DB key above is a
# custom-role JWT like reporting_readonly: it becomes the gateway apikey while the DB
# key rides as the bearer. Leave empty only if the DB key is a real service_role key.
SUPABASE_ANON_KEY=<anon-or-sb_publishable_key>

# Access control for STATIC-TOKEN mode. Do not use these on the OAuth deployment.
# Either set one admin token (all campuses):
MCP_ADMIN_TOKEN=<long-random-faculty-admin-token>   # >=24 chars, e.g. `secrets.token_urlsafe(24)`
# ...and/or a JSON map of per-faculty tokens to their allowed campuses.
# Each entry may carry an optional "expires" (ISO date/datetime) for revocation-by-date:
# MCP_TOKENS={"tok_indore_xyz":{"name":"Indore TNP","campuses":["indore"],"expires":"2026-12-31"},"tok_all":{"name":"Programme Office","campuses":null}}
# ALLOW_WEAK_TOKENS=false   # set true only to permit tokens <24 chars (dev/legacy)

# Interactive Google OAuth (recommended for Codex and other hosted MCP clients).
# Both Google values are required together. Configure the Google redirect URI as
# https://<your-mcp-host>/auth/callback.
GOOGLE_OAUTH_CLIENT_ID=<client-id>.apps.googleusercontent.com
GOOGLE_OAUTH_CLIENT_SECRET=<client-secret>
OAUTH_JWT_SIGNING_KEY=<long-stable-random-secret>
OAUTH_STORAGE_ENCRYPTION_KEY=<independent-long-random-secret>
OAUTH_ALLOWED_DOMAINS=jaipuria.ac.in
OAUTH_REDIRECT_HOSTS=<approved-hosted-client.example>
OAUTH_ALLOW_CROSS_CLIENT_PKCE=false
# Fail closed unless a faculty member has an explicit env or DB registry grant.
OAUTH_DEFAULT_CAMPUSES=none
# Optional break-glass overrides. null is an intentional all-campus grant.
# MCP_FACULTY={"dean@jaipuria.ac.in":{"name":"Dean","campuses":["jaipur"]}}

# Identity
MCP_SERVER_NAME=jaipuria-moodle-mcp
MCP_SERVER_VERSION=1.0.0
MCP_SERVER_BASE_URL=https://moodle-mcp.tryrehearsal.ai

# Reports
REPORT_PUBLIC_BASE_URL=https://reports.tryrehearsal.ai
STORAGE_BUCKET=student-reports
REPORT_PURPOSE=final
AGENT_API_BASE=https://reports.tryrehearsal.ai
AGENT_SHARED_SECRET=<independent-32+-character-random-secret>
# Legacy synchronous rollback only; the queued path never receives this admin credential.
AGENT_ADMIN_USER=
AGENT_ADMIN_PASS=
AGENT_REPORT_QUEUE=true

# Rate limiting (per token, sliding window) — tool calls allowed per window
MCP_RATE_LIMIT=90
MCP_RATE_WINDOW_SECONDS=60

# Transport hardening
MCP_MAX_BODY_BYTES=262144   # reject requests whose declared or received body is larger (413)
MCP_IP_RATE_LIMIT=1200      # per-IP pre-auth cap; campus users may share one NAT address
MCP_RATE_LIMIT_MAX_KEYS=16384
MCP_REDIS_URL=<tls-redis-url>
MCP_TRUST_PROXY_HEADERS=false
MCP_ALLOWED_HOSTS=moodle-mcp.tryrehearsal.ai
MCP_AUDIT_HMAC_KEY=<independent-long-random-secret>
MCP_REQUIRE_AUDIT=false
